# syntax=docker/dockerfile:1
# Cyphward browser worker image (packet C2b): a small, separate worker that loads a verified
# domain's homepage once in headless Chromium and reports what a first visit looked like.
# - Debian's Chromium (security-updated by the distro), no browser download at build time
# - Python deps limited to the worker and the shared contract; no FastAPI, no database driver
# - Runs as a non-root user; meant to run read-only with tmpfs, all capabilities dropped,
#   768 MiB memory and a 256 MiB /dev/shm (see docs/runbooks/browser-worker.md)
FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    HOME=/tmp \
    TMPDIR=/tmp \
    BROWSER_CHROMIUM_PATH=/usr/bin/chromium

RUN apt-get update && apt-get install -y --no-install-recommends \
        chromium fonts-liberation ca-certificates tini \
    && rm -rf /var/lib/apt/lists/*

COPY browser_worker/requirements.txt /tmp/browser-requirements.txt
RUN pip install -r /tmp/browser-requirements.txt && rm /tmp/browser-requirements.txt

RUN useradd --system --uid 10001 --user-group --no-create-home --shell /usr/sbin/nologin browser

WORKDIR /opt/cyphward-browser
COPY shared/ ./shared/
COPY browser_worker/ ./browser_worker/
# Only the scanner's address-safety module is shared with the backend; nothing else of it ships here.
COPY backend/app/scanner/ip_guard.py ./backend/app/scanner/ip_guard.py
RUN touch backend/app/__init__.py backend/app/scanner/__init__.py \
    && chown -R root:root /opt/cyphward-browser && chmod -R a-w /opt/cyphward-browser

USER 10001:10001

# Fails closed at startup when BROWSER_CORE_URL / BROWSER_API_KEY are missing.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "-m", "browser_worker"]
