# Cyphward environment configuration for LOCAL DEVELOPMENT (copy to .env).
# The backend automatically loads the root `.env` (or `backend/.env`).
# Never put production credentials in a working-copy .env. Production values
# live in the hosting provider's environment (Render/Vercel), not in this repo.

# "production" only on deployed services. Outside production, a non-loopback
# DATABASE_URL makes the API refuse to start the scheduler and recovery loops.
CYPHWARD_ENV=development

# Local CyphBot chart lab (laptops only): also needs a loopback DATABASE_URL.
# CYPHWARD_ARTIFACT_LAB=true
# Production CyphBot charts (Render): set both on the production service.
# CYPHWARD_ARTIFACT_REPORTS=true
# CYPHWARD_ARTIFACT_AI=live
# Frontend chart chip (Vercel build): VITE_CYPHWARD_ARTIFACT_LAB=true

# --- Database (local Postgres on loopback) ---
DATABASE_URL=postgresql://cyphward_app:cyphward_dev@127.0.0.1:5432/cyphward_dev
# Production shape (set on the hosting provider only):
# DATABASE_URL=postgresql://postgres.your-project:password@aws-1-eu-west-1.pooler.supabase.com:6543/postgres

# --- Connection pool (bounded pool; waits up to the timeout, then 503) ---
DB_POOL_MIN=1
DB_POOL_MAX=20
DB_POOL_TIMEOUT_SECONDS=5.0

# Optional — least-privileged application role (no superuser/BYPASSRLS).
# Created by supabase/migrations/20261004160000_least_privileged_app_role.sql;
# set its password out-of-band, then point DATABASE_URL here to run the app
# with real RLS enforcement instead of BYPASSRLS.
# Note: through the Supavisor pooler the username must be <role>.<project-ref>.
CYPHWARD_APP_DATABASE_URL=postgresql://cyphward_app:cyphward_dev@127.0.0.1:5432/cyphward_dev

# --- Auth (built-in: sessions, password reset, Google sign-in) ---
# HS256 secret for signing access tokens. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=change-me-to-a-long-random-secret
# Public origin of the frontend (used in password-reset links)
FRONTEND_URL=http://localhost:5173
# Optional — Google sign-in (Google Cloud Console → OAuth 2.0 credentials).
# Leave empty to hide the "Continue with Google" button's server flow.
# Console setup required for the One Tap popup (Google blocks any origin
# that is not allow-listed — "JavaScript origin" error):
#   Authorized JavaScript origins:
#     https://cyphward.com
#     https://auth.cyphward.com
#     http://localhost:5173
#   Authorized redirect URIs:
#     https://cyphward.com/api/v1/auth/google/callback
#     http://localhost:8000/api/v1/auth/google/callback  (= GOOGLE_REDIRECT_URI)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Email (Brevo — every product email, including sign-in & password reset) ---
BREVO_API_KEY=
BREVO_SMTP_SERVER=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_PASSWORD=
BREVO_SENDER_NAME=Cyphward Security
BREVO_SENDER_EMAIL=security@your-domain.tld

# --- Newsletter (docs/newsletter/README.md). Off by default; stays off until every value below is set. ---
NEWSLETTER_ENABLED=false
# GrokBot's draft key: 32+ random characters. It can create drafts only.
NEWSLETTER_DRAFT_API_KEY=
# Keys the one-click unsubscribe links: 32+ random characters. Changing it retires links in issues already sent.
NEWSLETTER_TOKEN_SECRET=
# Brevo list for confirmed subscribers only (never list 2, which the transactional mailer uses as a fallback).
NEWSLETTER_BREVO_LIST_ID=
NEWSLETTER_BREVO_UNSUB_ATTRIBUTE=CW_UNSUB_TOKEN
# Printed at the foot of every newsletter email.
NEWSLETTER_POSTAL_LINE=
NEWSLETTER_PUBLIC_BASE_URL=https://cyphward.com

# --- AI providers ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite
OPENAI_API_KEY=

# --- Scanner execution and recovery ---
SCANNER_MODE=local
# DNS target cap shared by local scans and transmitted VPS job limits.
SCANNER_DNS_MAX_HOSTS=40
# Recon work only; queue time, Core finalisation and control-plane writes excluded.
SCANNER_RECON_TIMEOUT_SECONDS=900
SCANNER_TLS_MAX_HOSTS=25
SCANNER_API_KEY=
SCANNER_CLAIMS_ENABLED=true
SCANNER_LEASE_SECONDS=3600
CORE_AI_TIMEOUT_SECONDS=120
# Consumes durable local jobs and recovers expired Core leases.
CYPHWARD_EXECUTION_RECOVERY_ENABLED=true
