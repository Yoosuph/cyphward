# syntax=docker/dockerfile:1
# Cyphward scanner worker image (spec §13/§17/§23)
# - Pinned ProjectDiscovery prebuilt binaries (no compilation on the VM)
# - Connect-mode port scan (naabu -connect): no raw sockets, no NET_ADMIN
# - Python deps limited to worker + shared runners (no FastAPI / DB drivers)
FROM python:3.12-slim-bookworm

ARG SUBFINDER_VERSION=2.16.0
ARG NAABU_VERSION=2.6.1
ARG HTTPX_VERSION=1.12.0
ARG NUCLEI_VERSION=3.11.1
# Pinned so the safe-scan exclusion policy (scanner/nuclei_policy/) is reproducible.
ARG NUCLEI_TEMPLATES_VERSION=10.4.9

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl unzip libpcap0.8 \
    && rm -rf /var/lib/apt/lists/*

# --- Python deps for scanner runners + contracts --------------------------
# NOTE: pip ships an `httpx` console script that would clobber the
# ProjectDiscovery httpx binary — install pip deps BEFORE the tools step.
RUN pip install \
        "httpx>=0.27,<1" \
        "dnspython>=2.6,<3" \
        "pydantic>=2.8,<3" \
        "python-dotenv>=1.0,<2" \
        "sslyze>=6,<7"

# --- ProjectDiscovery tools (pinned releases) -----------------------------
RUN set -eux; \
    for spec in "subfinder:${SUBFINDER_VERSION}" "naabu:${NAABU_VERSION}" \
                "httpx:${HTTPX_VERSION}" "nuclei:${NUCLEI_VERSION}"; do \
        tool="${spec%%:*}"; ver="${spec##*:}"; \
        curl -fsSL -o "/tmp/${tool}.zip" \
            "https://github.com/projectdiscovery/${tool}/releases/download/v${ver}/${tool}_${ver}_linux_amd64.zip"; \
        rm -rf /tmp/unz; mkdir -p /tmp/unz; \
        unzip -q "/tmp/${tool}.zip" -d /tmp/unz; \
        bin="$(find /tmp/unz -type f -name "${tool}" | head -n1)"; \
        test -n "$bin"; \
        install -m 0755 "${bin}" "/usr/local/bin/${tool}"; \
        rm -rf "/tmp/${tool}.zip" /tmp/unz; \
    done

# --- App code --------------------------------------------------------------
WORKDIR /opt/cyphward-scanner
COPY shared/ ./shared/
COPY backend/ ./backend/
COPY scanner/ ./scanner/

# --- Nuclei templates, pinned (runner uses the http/ subset) --------------
# Pinned to the version the exclusion policy was built against, so the safe
# scan set is reproducible, then verified against the committed policy so a
# template change cannot silently widen what the scanner runs.
RUN set -eux; \
    curl -fsSL -o /tmp/templates.tar.gz \
        "https://github.com/projectdiscovery/nuclei-templates/archive/refs/tags/v${NUCLEI_TEMPLATES_VERSION}.tar.gz"; \
    mkdir -p /root/nuclei-templates; \
    tar -xzf /tmp/templates.tar.gz -C /root/nuclei-templates --strip-components=1; \
    rm /tmp/templates.tar.gz; \
    mkdir -p /root/.config/nuclei; \
    printf '{"nuclei-templates-directory":"/root/nuclei-templates","nuclei-templates-version":"v%s"}\n' \
        "${NUCLEI_TEMPLATES_VERSION}" > /root/.config/nuclei/.templates-config.json; \
    python3 -I scanner/scripts/verify_nuclei_excludes.py /root/nuclei-templates scanner/nuclei_policy

# Fail closed at startup when SCANNER_CORE_URL / SCANNER_API_KEY are missing.
CMD ["python", "-m", "scanner.runner"]
