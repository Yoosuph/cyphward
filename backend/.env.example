# Cyphward Backend Environment Configuration
# Note: The backend automatically loads the root `.env` or `backend/.env`.

# PostgreSQL Database URL (Supabase Connection Pooler)
DATABASE_URL=postgresql://postgres.your-project:password@aws-1-eu-west-1.pooler.supabase.com:6543/postgres

# Bounded pool: min/max connections and how long to wait before returning 503
DB_POOL_MIN=1
DB_POOL_MAX=20
DB_POOL_TIMEOUT_SECONDS=5.0
# Optional least-privileged role (migration 20261004160000) — point
# DATABASE_URL at this to drop BYPASSRLS. Pooler username needs <role>.<ref>.
CYPHWARD_APP_DATABASE_URL=

# --- Own auth (sessions, password reset, Google sign-in) ---
# HS256 secret for signing access tokens (required at runtime).
AUTH_JWT_SECRET=change-me-to-a-long-random-secret
# Public origin of the frontend (password-reset links point here).
FRONTEND_URL=http://localhost:5173
# Optional — Google OAuth 2.0 client credentials.
# One Tap popup requires these page origins in the console client's
# "Authorized JavaScript origins": https://cyphward.com,
# https://auth.cyphward.com, http://localhost:5173 — and GOOGLE_REDIRECT_URI
# must be listed under "Authorized redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Email (Brevo — all product email, including auth) ---
BREVO_API_KEY=
BREVO_SMTP_SERVER=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_PASSWORD=
BREVO_SENDER_NAME=Cyphward Security
BREVO_SENDER_EMAIL=security@your-domain.tld

# Inngest Background Workers Configuration
# Set INNGEST_IS_PRODUCTION=true in production with a valid signing key.
# In local development, the Inngest Dev Server (http://localhost:8288) auto-discovers handlers without keys.
INNGEST_IS_PRODUCTION=false
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# AI Provider (Google Gemini with low token consumption, OpenAI, or local simulated mode)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite
OPENAI_API_KEY=
