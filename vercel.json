{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.cyphward.com"
        }
      ],
      "destination": "https://cyphward.com/$1",
      "permanent": true
    },
    {
      "source": "/landing",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/security.txt",
      "destination": "/.well-known/security.txt",
      "permanent": true
    },
    {
      "source": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "app.cyphward.com"
        }
      ],
      "destination": "/robots-noindex.txt",
      "permanent": false
    },
    {
      "source": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "auth.cyphward.com"
        }
      ],
      "destination": "/robots-noindex.txt",
      "permanent": false
    },
    {
      "source": "/(login|signup|forgot-password|reset-password|auth/callback)",
      "has": [
        {
          "type": "host",
          "value": "cyphward.com"
        }
      ],
      "destination": "https://auth.cyphward.com/$1",
      "permanent": false
    },
    {
      "source": "/onboarding/:path*",
      "has": [
        {
          "type": "host",
          "value": "cyphward.com"
        }
      ],
      "destination": "https://app.cyphward.com/onboarding/:path*",
      "permanent": false
    },
    {
      "source": "/(overview|assets|findings|scans|domains|remediation|reports|settings|analytics|comply|dashboard|copilot|detect|score|academy|sso|platform)",
      "has": [
        {
          "type": "host",
          "value": "cyphward.com"
        }
      ],
      "destination": "https://app.cyphward.com/$1",
      "permanent": false
    },
    {
      "source": "/onboarding/:path*",
      "has": [
        {
          "type": "host",
          "value": "auth.cyphward.com"
        }
      ],
      "destination": "https://app.cyphward.com/onboarding/:path*",
      "permanent": false
    },
    {
      "source": "/(overview|assets|findings|scans|domains|remediation|reports|settings|analytics|comply|dashboard|copilot|detect|score|academy|sso|platform)",
      "has": [
        {
          "type": "host",
          "value": "auth.cyphward.com"
        }
      ],
      "destination": "https://app.cyphward.com/$1",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "auth.cyphward.com"
        }
      ],
      "destination": "/login",
      "permanent": false
    },
    {
      "source": "/(terms|privacy|landing|pricing|about)",
      "has": [
        {
          "type": "host",
          "value": "auth.cyphward.com"
        }
      ],
      "destination": "https://cyphward.com/$1",
      "permanent": false
    },
    {
      "source": "/(login|signup|forgot-password|reset-password|auth/callback)",
      "has": [
        {
          "type": "host",
          "value": "app.cyphward.com"
        }
      ],
      "destination": "https://auth.cyphward.com/$1",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "app.cyphward.com"
        }
      ],
      "destination": "/overview",
      "permanent": false
    },
    {
      "source": "/(terms|privacy|landing|pricing|about)",
      "has": [
        {
          "type": "host",
          "value": "app.cyphward.com"
        }
      ],
      "destination": "https://cyphward.com/$1",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://cyphward-core.onrender.com/api/$1"
    },
    {
      "source": "/(overview|assets|findings|scans|domains|remediation|reports|settings|login|signup|forgot-password|reset-password|analytics|comply|dashboard|copilot|detect|score|academy|sso|platform)",
      "destination": "/app.html"
    },
    {
      "source": "/onboarding/:path*",
      "destination": "/app.html"
    },
    {
      "source": "/auth/callback",
      "destination": "/app.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; frame-src https://accounts.google.com; connect-src 'self' https://accounts.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(index.html|app.html|privacy/index.html|terms/index.html|pricing/index.html|about/index.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/app.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
