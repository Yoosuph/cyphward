# Copy values into the worker's protected EnvironmentFile. Keep the API key
# private; do not commit /etc/cyphward-scanner/env or a populated .env.
SCANNER_CORE_URL=https://cyphward-core.onrender.com
SCANNER_API_KEY=
SCANNER_ID=az-scanner-01
SCANNER_POLL_INTERVAL_SECONDS=30
SCANNER_HEARTBEAT_SECONDS=30

# Small-VPS defaults. These limit work INSIDE each Nuclei process, separately
# from the job's maximum host concurrency supplied by Core.
SCANNER_NUCLEI_MAX_PROCESSES=1
SCANNER_NUCLEI_TEMPLATE_CONCURRENCY=4
SCANNER_NUCLEI_PAYLOAD_CONCURRENCY=1
SCANNER_NUCLEI_JS_CONCURRENCY=1
SCANNER_NUCLEI_LOADING_CONCURRENCY=1
SCANNER_NUCLEI_GOMEMLIMIT=384MiB
SCANNER_NUCLEI_GOGC=50
SCANNER_NUCLEI_GOMAXPROCS=1

# GOMEMLIMIT is a Go-runtime soft limit, not a Docker hard memory limit.
# Raising parallel processes requires enough container AND host headroom.
